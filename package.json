{
	"name": "n8n-nodes-duva",
	"version": "0.1.0",
	"description": "n8n node for Duva, the transactional email API hosted in Canada: send email, read delivery events, manage the suppression list.",
	"license": "MIT",
	"homepage": "https://duva.ca",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"duva",
		"email",
		"transactional-email"
	],
	"author": {
		"name": "9573-4562 Québec inc.",
		"email": "support@duva.ca"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/duva-mail/duva-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/duva-mail/duva-n8n/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"test": "n8n-node build && node --test test/duva.test.js",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DuvaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Duva/Duva.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
